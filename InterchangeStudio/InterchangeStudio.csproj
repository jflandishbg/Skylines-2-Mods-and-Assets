<Project Sdk="Microsoft.NET.Sdk">
  <!-- The mod. Core\ is the pure planner (also built alone by Build\CorePurity to prove it never touches the game);
       Game\ is the adapter that mirrors the city into it and writes its plans back. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>InterchangeStudio</AssemblyName>
    <RootNamespace>InterchangeStudio</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <DeployDir>$(USERPROFILE)\AppData\LocalLow\Colossal Order\Cities Skylines II\Mods\InterchangeStudio</DeployDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Core\**\*.cs;Game\**\*.cs" />
    <Reference Include="$(GameManaged)\Game.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.Core.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.Logging.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.Mathematics.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.Collections.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.IO.AssetDatabase.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Entities.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Collections.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Mathematics.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.Burst.dll" Private="false" />
    <Reference Include="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManaged)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.Localization.dll" Private="false" />
    <Reference Include="$(GameManaged)\Colossal.UI.Binding.dll" Private="false" />
  </ItemGroup>
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(DeployOnBuild)' != 'false'">
    <MakeDir Directories="$(DeployDir);$(DeployDir)\images" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb;UI\InterchangeStudio.mjs;UI\InterchangeStudio.css" DestinationFolder="$(DeployDir)" />
    <ItemGroup><StudioIcons Include="UI\images\*.svg" /></ItemGroup>
    <Copy SourceFiles="@(StudioIcons)" DestinationFolder="$(DeployDir)\images" />
  </Target>
</Project>
